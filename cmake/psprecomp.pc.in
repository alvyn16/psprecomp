# Relocatable: works from any --prefix used at install time.
prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: psprecomp
Description: Static recompilation toolkit for PlayStation Portable games
Version: @PSPRECOMP_VERSION@
Requires: @PSPRECOMP_PC_REQUIRES@
Libs: -L${libdir} -lpsprecomp -lallegrex_core @PSPRECOMP_PC_EXTRA@
Cflags: -I${includedir}
